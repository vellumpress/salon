  "scenes": [
    {
      "id": "s0",
      "title": "That Bright Chimeric Beast",
      "place": "That Bright Chimeric Beast",
      "reentry": "Conceived yet never born,",
      "prompt": "What does the poem demand of you?"
    }
  ],
  "breaths": [
    {
      "id": "s0-0",
      "sceneId": "s0",
      "text": "(For Lynn Riggs)"
    },
    {
      "id": "s0-1",
      "sceneId": "s0",
      "text": "That bright chimeric beast"
    },
    {
      "id": "s0-2",
      "sceneId": "s0",
      "text": "Conceived yet never born,"
    },
    {
      "id": "s0-3",
      "sceneId": "s0",
      "text": "Save in the poet’s breast,"
    },
    {
      "id": "s0-4",
      "sceneId": "s0",
      "text": "The white-flanked unicorn,"
    },
    {
      "id": "s0-5",
      "sceneId": "s0",
      "text": "Never may be shaken"
    },
    {
      "id": "s0-6",
      "sceneId": "s0",
      "text": "From his solitude;"
    },
    {
      "id": "s0-7",
      "sceneId": "s0",
      "text": "Never may be taken"
    },
    {
      "id": "s0-8",
      "sceneId": "s0",
      "text": "In any earthly wood."
    },
    {
      "id": "s0-9",
      "sceneId": "s0",
      "text": "That bird forever feathered,"
    },
    {
      "id": "s0-10",
      "sceneId": "s0",
      "text": "Of its new self the sire,"
    },
    {
      "id": "s0-11",
      "sceneId": "s0",
      "text": "After aeons weathered,"
    },
    {
      "id": "s0-12",
      "sceneId": "s0",
      "text": "Reincarnate by fire,"
    },
    {
      "id": "s0-13",
      "sceneId": "s0",
      "text": "Falcon may not nor eagle"
    },
    {
      "id": "s0-14",
      "sceneId": "s0",
      "text": "Swerve from his eerie,"
    },
    {
      "id": "s0-15",
      "sceneId": "s0",
      "text": "Nor any crumb inveigle"
    },
    {
      "id": "s0-16",
      "sceneId": "s0",
      "text": "Down to an earthly tree."
    },
    {
      "id": "s0-17",
      "sceneId": "s0",
      "text": "That fish of the dread regime"
    },
    {
      "id": "s0-18",
      "sceneId": "s0",
      "text": "Invented to become"
    },
    {
      "id": "s0-19",
      "sceneId": "s0",
      "text": "The fable and the dream"
    },
    {
      "id": "s0-20",
      "sceneId": "s0",
      "text": "Of the Lord’s aquarium,"
    },
    {
      "id": "s0-21",
      "sceneId": "s0",
      "text": "Leviathan, the jointed"
    },
    {
      "id": "s0-22",
      "sceneId": "s0",
      "text": "Harpoon was never wrought"
    },
    {
      "id": "s0-23",
      "sceneId": "s0",
      "text": "By which the Lord’s anointed"
    },
    {
      "id": "s0-24",
      "sceneId": "s0",
      "text": "Will suffer to be caught."
    },
    {
      "id": "s0-25",
      "sceneId": "s0",
      "text": "Bird of the deathless breast,"
    },
    {
      "id": "s0-26",
      "sceneId": "s0",
      "text": "Fish of the frantic fin,"
    },
    {
      "id": "s0-27",
      "sceneId": "s0",
      "text": "That bright chimeric beast"
    },
    {
      "id": "s0-28",
      "sceneId": "s0",
      "text": "Flashing the argent skin,--"
    },
    {
      "id": "s0-29",
      "sceneId": "s0",
      "text": "If beasts like these you’d harry,"
    },
    {
      "id": "s0-30",
      "sceneId": "s0",
      "text": "Plumb then the poet’s dream;"
    },
    {
      "id": "s0-31",
      "sceneId": "s0",
      "text": "Make it your aviary,"
    },
    {
      "id": "s0-32",
      "sceneId": "s0",
      "text": "Make it your wood and stream."
    },
    {
      "id": "s0-33",
      "sceneId": "s0",
      "text": "There only shall the swish"
    },
    {
      "id": "s0-34",
      "sceneId": "s0",
      "text": "Be heard, of the regal fish;"
    },
    {
      "id": "s0-35",
      "sceneId": "s0",
      "text": "There like a golden knife"
    },
    {
      "id": "s0-36",
      "sceneId": "s0",
      "text": "Dart the feet of the unicorn,"
    },
    {
      "id": "s0-37",
      "sceneId": "s0",
      "text": "And there, death brought to life,"
    },
    {
      "id": "s0-38",
      "sceneId": "s0",
      "text": "The dead bird be reborn."
    }
  ]
}
