{
  "id": "goblin-market-and-other-poems",
  "title": "Goblin Market and Other Poems",
  "author": "Christina Rossetti",
  "year": "1862",
  "note": "Project Gutenberg 16950",
  "minutes": 186,
  "cover": "",
  "coverAlt": "",
  "scenes": [
    {
      "id": "s0",
      "title": "Goblin Market",
      "place": "Goblin Market",
      "reentry": "Morning and evening",
      "prompt": "A word from this stretch."
    }
  ],
  "breaths": [
    {
      "id": "s0-0",
      "sceneId": "s0",
      "text": "Morning and evening"
    },
    {
      "id": "s0-1",
      "sceneId": "s0",
      "text": "Maids heard the goblins cry:"
    },
    {
      "id": "s0-2",
      "sceneId": "s0",
      "text": "'Come buy our orchard fruits,"
    },
    {
      "id": "s0-3",
      "sceneId": "s0",
      "text": "Come buy, come buy:"
    },
    {
      "id": "s0-4",
      "sceneId": "s0",
      "text": "Apples and quinces,"
    },
    {
      "id": "s0-5",
      "sceneId": "s0",
      "text": "Lemons and oranges,"
    },
    {
      "id": "s0-6",
      "sceneId": "s0",
      "text": "Plump unpecked cherries,"
    },
    {
      "id": "s0-7",
      "sceneId": "s0",
      "text": "Melons and raspberries,"
    },
    {
      "id": "s0-8",
      "sceneId": "s0",
      "text": "Bloom-down-cheeked peaches,"
    },
    {
      "id": "s0-9",
      "sceneId": "s0",
      "text": "Swart-headed mulberries,                                           10"
    },
    {
      "id": "s0-10",
      "sceneId": "s0",
      "text": "Wild free-born cranberries,"
    },
    {
      "id": "s0-11",
      "sceneId": "s0",
      "text": "Crab-apples, dewberries,"
    },
    {
      "id": "s0-12",
      "sceneId": "s0",
      "text": "Pine-apples, blackberries,"
    },
    {
      "id": "s0-13",
      "sceneId": "s0",
      "text": "Apricots, strawberries;--"
    },
    {
      "id": "s0-14",
      "sceneId": "s0",
      "text": "All ripe together"
    },
    {
      "id": "s0-15",
      "sceneId": "s0",
      "text": "In summer weather,--"
    },
    {
      "id": "s0-16",
      "sceneId": "s0",
      "text": "Morns that pass by,"
    },
    {
      "id": "s0-17",
      "sceneId": "s0",
      "text": "Fair eves that fly;"
    },
    {
      "id": "s0-18",
      "sceneId": "s0",
      "text": "Come buy, come buy:"
    },
    {
      "id": "s0-19",
      "sceneId": "s0",
      "text": "Our grapes fresh from the vine,                                    20"
    },
    {
      "id": "s0-20",
      "sceneId": "s0",
      "text": "Pomegranates full and fine,"
    },
    {
      "id": "s0-21",
      "sceneId": "s0",
      "text": "Dates and sharp bullaces,"
    },
    {
      "id": "s0-22",
      "sceneId": "s0",
      "text": "Rare pears and greengages,"
    },
    {
      "id": "s0-23",
      "sceneId": "s0",
      "text": "Damsons and bilberries,"
    },
    {
      "id": "s0-24",
      "sceneId": "s0",
      "text": "Taste them and try:"
    },
    {
      "id": "s0-25",
      "sceneId": "s0",
      "text": "Currants and gooseberries,"
    },
    {
      "id": "s0-26",
      "sceneId": "s0",
      "text": "Bright-fire-like barberries,"
    },
    {
      "id": "s0-27",
      "sceneId": "s0",
      "text": "Figs to fill your mouth,"
    },
    {
      "id": "s0-28",
      "sceneId": "s0",
      "text": "Citrons from the South,"
    },
    {
      "id": "s0-29",
      "sceneId": "s0",
      "text": "Sweet to tongue and sound to eye;                                  30"
    },
    {
      "id": "s0-30",
      "sceneId": "s0",
      "text": "Come buy, come buy.'"
    },
    {
      "id": "s0-31",
      "sceneId": "s0",
      "text": "Evening by evening"
    },
    {
      "id": "s0-32",
      "sceneId": "s0",
      "text": "Among the brookside rushes,"
    },
    {
      "id": "s0-33",
      "sceneId": "s0",
      "text": "Laura bowed her head to hear,"
    },
    {
      "id": "s0-34",
      "sceneId": "s0",
      "text": "Lizzie veiled her blushes:"
    },
    {
      "id": "s0-35",
      "sceneId": "s0",
      "text": "Crouching close together"
    },
    {
      "id": "s0-36",
      "sceneId": "s0",
      "text": "In the cooling weather,"
    },
    {
      "id": "s0-37",
      "sceneId": "s0",
      "text": "With clasping arms and cautioning lips,"
    },
    {
      "id": "s0-38",
      "sceneId": "s0",
      "text": "With tingling cheeks and finger tips."
    },
    {
      "id": "s0-39",
      "sceneId": "s0",
      "text": "'Lie close,' Laura said,                                           40"
    },
    {
      "id": "s0-40",
      "sceneId": "s0",
      "text": "Pricking up her golden head:"
    },
    {
      "id": "s0-41",
      "sceneId": "s0",
      "text": "'We must not look at goblin men,"
    },
    {
      "id": "s0-42",
      "sceneId": "s0",
      "text": "We must not buy their fruits:"
    },
    {
      "id": "s0-43",
      "sceneId": "s0",
      "text": "Who knows upon what soil they fed"
    },
    {
      "id": "s0-44",
      "sceneId": "s0",
      "text": "Their hungry thirsty roots?'"
    },
    {
      "id": "s0-45",
      "sceneId": "s0",
      "text": "'Come buy,' call the goblins"
    },
    {
      "id": "s0-46",
      "sceneId": "s0",
      "text": "Hobbling down the glen."
    },
    {
      "id": "s0-47",
      "sceneId": "s0",
      "text": "'Oh,' cried Lizzie, 'Laura, Laura,"
    },
    {
      "id": "s0-48",
      "sceneId": "s0",
      "text": "You should not peep at goblin men.'"
    },
    {
      "id": "s0-49",
      "sceneId": "s0",
      "text": "Lizzie covered up her eyes,                                        50"
    },
    {
      "id": "s0-50",
      "sceneId": "s0",
      "text": "Covered close lest they should look;"
    },
    {
      "id": "s0-51",
      "sceneId": "s0",
      "text": "Laura reared her glossy head,"
    },
    {
      "id": "s0-52",
      "sceneId": "s0",
      "text": "And whispered like the restless brook:"
    },
    {
      "id": "s0-53",
      "sceneId": "s0",
      "text": "'Look, Lizzie, look, Lizzie,"
    },
    {
      "id": "s0-54",
      "sceneId": "s0",
      "text": "Down the glen tramp little men."
    },
    {
      "id": "s0-55",
      "sceneId": "s0",
      "text": "One hauls a basket,"
    },
    {
      "id": "s0-56",
      "sceneId": "s0",
      "text": "One bears a plate,"
    },
    {
      "id": "s0-57",
      "sceneId": "s0",
      "text": "One lugs a golden dish"
    },
    {
      "id": "s0-58",
      "sceneId": "s0",
      "text": "Of many pounds weight."
    },
    {
      "id": "s0-59",
      "sceneId": "s0",
      "text": "How fair the vine must grow                                        60"
    },
    {
      "id": "s0-60",
      "sceneId": "s0",
      "text": "Whose grapes are so luscious;"
    },
    {
      "id": "s0-61",
      "sceneId": "s0",
      "text": "How warm the wind must blow"
    },
    {
      "id": "s0-62",
      "sceneId": "s0",
      "text": "Through those fruit bushes.'"
    },
    {
      "id": "s0-63",
      "sceneId": "s0",
      "text": "'No,' said Lizzie, 'No, no, no;"
    },
    {
      "id": "s0-64",
      "sceneId": "s0",
      "text": "Their offers should not charm us,"
    },
    {
      "id": "s0-65",
      "sceneId": "s0",
      "text": "Their evil gifts would harm us.'"
    },
    {
      "id": "s0-66",
      "sceneId": "s0",
      "text": "She thrust a dimpled finger"
    },
    {
      "id": "s0-67",
      "sceneId": "s0",
      "text": "In each ear, shut eyes and ran:"
    },
    {
      "id": "s0-68",
      "sceneId": "s0",
      "text": "Curious Laura chose to linger"
    },
    {
      "id": "s0-69",
      "sceneId": "s0",
      "text": "Wondering at each merchant man.                                    70"
    },
    {
      "id": "s0-70",
      "sceneId": "s0",
      "text": "One had a cat's face,"
    },
    {
      "id": "s0-71",
      "sceneId": "s0",
      "text": "One whisked a tail,"
    },
    {
      "id": "s0-72",
      "sceneId": "s0",
      "text": "One tramped at a rat's pace,"
    },
    {
      "id": "s0-73",
      "sceneId": "s0",
      "text": "One crawled like a snail,"
    },
    {
      "id": "s0-74",
      "sceneId": "s0",
      "text": "One like a wombat prowled obtuse and furry,"
    },
    {
      "id": "s0-75",
      "sceneId": "s0",
      "text": "One like a ratel tumbled hurry skurry."
    },
    {
      "id": "s0-76",
      "sceneId": "s0",
      "text": "She heard a voice like voice of doves"
    },
    {
      "id": "s0-77",
      "sceneId": "s0",
      "text": "Cooing all together:"
    },
    {
      "id": "s0-78",
      "sceneId": "s0",
      "text": "They sounded kind and full of loves"
    },
    {
      "id": "s0-79",
      "sceneId": "s0",
      "text": "In the pleasant weather.                                           80"
    },
    {
      "id": "s0-80",
      "sceneId": "s0",
      "text": "Laura stretched her gleaming neck"
    },
    {
      "id": "s0-81",
      "sceneId": "s0",
      "text": "Like a rush-imbedded swan,"
    },
    {
      "id": "s0-82",
      "sceneId": "s0",
      "text": "Like a lily from the beck,"
    },
    {
      "id": "s0-83",
      "sceneId": "s0",
      "text": "Like a moonlit poplar branch,"
    },
    {
      "id": "s0-84",
      "sceneId": "s0",
      "text": "Like a vessel at the launch"
    },
    {
      "id": "s0-85",
      "sceneId": "s0",
      "text": "When its last restraint is gone."
    },
    {
      "id": "s0-86",
      "sceneId": "s0",
      "text": "Backwards up the mossy glen"
    },
    {
      "id": "s0-87",
      "sceneId": "s0",
      "text": "Turned and trooped the goblin men,"
    },
    {
      "id": "s0-88",
      "sceneId": "s0",
      "text": "With their shrill repeated cry,"
    },
    {
      "id": "s0-89",
      "sceneId": "s0",
      "text": "'Come buy, come buy.'                                              90"
    }
  ]
}
