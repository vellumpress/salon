  "breaths": [
    {
      "id": "s0-0",
      "sceneId": "s0",
      "text": "(Adapted from the poet Yakura Sangin, 1769)"
    },
    {
      "id": "s0-1",
      "sceneId": "s0",
      "text": "As I wandered through the eight hundred and eight"
    },
    {
      "id": "s0-2",
      "sceneId": "s0",
      "text": "streets of the city,"
    },
    {
      "id": "s0-3",
      "sceneId": "s0",
      "text": "I saw nothing so beautiful"
    },
    {
      "id": "s0-4",
      "sceneId": "s0",
      "text": "As the Women of the Green Houses,"
    },
    {
      "id": "s0-5",
      "sceneId": "s0",
      "text": "With their girdles of spun gold,"
    },
    {
      "id": "s0-6",
      "sceneId": "s0",
      "text": "And their long-sleeved dresses,"
    },
    {
      "id": "s0-7",
      "sceneId": "s0",
      "text": "Coloured like the graining of wood."
    },
    {
      "id": "s0-8",
      "sceneId": "s0",
      "text": "As they walk,"
    },
    {
      "id": "s0-9",
      "sceneId": "s0",
      "text": "The hemsof their outer garments flutter open,"
    },
    {
      "id": "s0-10",
      "sceneId": "s0",
      "text": "And the blood-red linings glow like sharp-toothed"
    },
    {
      "id": "s0-11",
      "sceneId": "s0",
      "text": "maple leaves"
    },
    {
      "id": "s0-12",
      "sceneId": "s0",
      "text": "In Autumn."
    },
    {
      "id": "s0-13",
      "sceneId": "s0",
      "text": "By MEssENGER"
    },
    {
      "id": "s0-14",
      "sceneId": "s0",
      "text": "OnE night"
    },
    {
      "id": "s0-15",
      "sceneId": "s0",
      "text": "When there was a clear moon,"
    },
    {
      "id": "s0-16",
      "sceneId": "s0",
      "text": "I sat down"
    },
    {
      "id": "s0-17",
      "sceneId": "s0",
      "text": "To write a poem"
    },
    {
      "id": "s0-18",
      "sceneId": "s0",
      "text": "About maple-trees."
    },
    {
      "id": "s0-19",
      "sceneId": "s0",
      "text": "But the dazzle of moonlight"
    },
    {
      "id": "s0-20",
      "sceneId": "s0",
      "text": "In the ink"
    },
    {
      "id": "s0-21",
      "sceneId": "s0",
      "text": "Blinded me,"
    },
    {
      "id": "s0-22",
      "sceneId": "s0",
      "text": "And I could only write"
    },
    {
      "id": "s0-23",
      "sceneId": "s0",
      "text": "What I remembered."
    },
    {
      "id": "s0-24",
      "sceneId": "s0",
      "text": "Therefore, on the wrapping of my poem"
    },
    {
      "id": "s0-25",
      "sceneId": "s0",
      "text": "I have inscribed your name."
    },
    {
      "id": "s1-0",
      "sceneId": "s1",
      "text": "Upon the maple leaves"
    },
    {
      "id": "s1-1",
      "sceneId": "s1",
      "text": "The dew shines red,"
    },
    {
      "id": "s1-2",
      "sceneId": "s1",
      "text": "But on the lotus blossom"
    },
    {
      "id": "s1-3",
      "sceneId": "s1",
      "text": "It has the pale transparence of tears."
    },
    {
      "id": "s2-0",
      "sceneId": "s2",
      "text": "THE rain is dark against the white sky,"
    },
    {
      "id": "s2-1",
      "sceneId": "s2",
      "text": "Or white against the foliage of eucalyptus-trees."
    },
    {
      "id": "s2-2",
      "sceneId": "s2",
      "text": "But, in the cistern, it is a sheet of mauve and amber,"
    },
    {
      "id": "s2-3",
      "sceneId": "s2",
      "text": "Because of the chrysanthemums"
    },
    {
      "id": "s2-4",
      "sceneId": "s2",
      "text": "Heaped about its edge."
    },
    {
      "id": "s2-5",
      "sceneId": "s2",
      "text": "VicaRIOUS"
    },
    {
      "id": "s2-6",
      "sceneId": "s2",
      "text": "WueEn I stand under the willow-tree"
    },
    {
      "id": "s2-7",
      "sceneId": "s2",
      "text": "Above the river,"
    },
    {
      "id": "s2-8",
      "sceneId": "s2",
      "text": "In my straw-coloured silken garment"
    },
    {
      "id": "s2-9",
      "sceneId": "s2",
      "text": "Embroidered with purple chrysanthemums,            ,"
    },
    {
      "id": "s2-10",
      "sceneId": "s2",
      "text": "It is not at the bright water"
    },
    {
      "id": "s2-11",
      "sceneId": "s2",
      "text": "That I am gazing,"
    },
    {
      "id": "s2-12",
      "sceneId": "s2",
      "text": "But at your portrait,"
    },
    {
      "id": "s2-13",
      "sceneId": "s2",
      "text": "Which I have caused to be painted"
    },
    {
      "id": "s2-14",
      "sceneId": "s2",
      "text": "On my fan."
    },
    {
      "id": "s2-15",
      "sceneId": "s2",
      "text": "Negar Kioto"
    },
    {
      "id": "s2-16",
      "sceneId": "s2",
      "text": "As I crossed over the bridge of Ariwarano Narikira,"
    },
    {
      "id": "s2-17",
      "sceneId": "s2",
      "text": "I saw that the waters were purple"
    },
    {
      "id": "s2-18",
      "sceneId": "s2",
      "text": "With the floating leaves of maples."
    }
  ]
}
